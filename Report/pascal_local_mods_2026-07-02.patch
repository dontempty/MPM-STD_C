     public :: mpi_Post_Div
     public :: mpi_Post_CFL
     public :: mpi_Post_MonitorOut
+    public :: mpi_Post_ThetaC
     !> @}
 
     !> @{ MPI derived datatype for file IO
@@ -255,6 +256,39 @@ module mpi_Post
 
     end subroutine mpi_Post_MonitorOut
 
+    !> Compute horizontal-mean temperature at the wall-normal midplane (j = n2m/2).
+    subroutine mpi_Post_ThetaC(T, thetaC)
+        use mpi
+
+        implicit none
+        double precision, intent(in)  :: T(0:n1sub, 0:n2sub, 0:n3sub)
+        double precision, intent(out) :: thetaC
+
+        integer          :: i, k, jmid_loc, ierr
+        double precision :: local_sum, global_sum
+        integer          :: n1n3_global, jmid_global
+
+        ! Global midplane index (1-based interior)
+        jmid_global = n2m / 2
+
+        ! Corresponding local index in this rank's subdomain
+        jmid_loc = jmid_global - jsta + 1
+
+        local_sum = 0.d0
+        if (jmid_loc >= 1 .and. jmid_loc <= n2msub) then
+            do k = 1, n3msub
+                do i = 1, n1msub
+                    local_sum = local_sum + T(i, jmid_loc, k)
+                end do
+            end do
+        end if
+
+        call MPI_Allreduce(local_sum, global_sum, 1, MPI_DOUBLE_PRECISION, MPI_SUM, MPI_COMM_WORLD, ierr)
+        n1n3_global = n1m * n3m
+        thetaC = global_sum / dble(n1n3_global)
+
+    end subroutine mpi_Post_ThetaC
+
     !>
     !> @brief       Write instantaneous field variables for post-processing in ascii format to file
     !> @detail      An example subroutine
