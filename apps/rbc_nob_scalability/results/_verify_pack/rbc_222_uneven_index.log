# settings loaded from rbc_222_uneven.ini  (8 ranks, tdma=pascal)
[mesh]
nx = 70
ny = 54
nz = 40

[domain]
lx = 12
ly = 12
lz = 2

[stretch]
uniform_z = false
gamma_z = 2.6

[process]
npx = 2
npy = 2
npz = 2

[physics]
rayleigh = 1000000
prandtl = 2547
delta_temperature = 40

[initial]
perturb = 0.05

[time]
max_step = 30
dt_max = 0.05
max_cfl = 0.3
viscous_coupling_number = 12

[output]
monitor_interval = 5

[timing]
warmup_steps = 5
solver_phases = false
