[mesh]
nx = 2048
ny = 2048
nz = 4096

[domain]
lx = 24
ly = 24
lz = 8

[stretch]
uniform_z = false
gamma_z = 2.6

[process]
npx = 4
npy = 4
npz = 8

[physics]
rayleigh = 1000000
prandtl = 2547
delta_temperature = 40

[initial]
perturb = 0.05

[time]
max_step = 200
dt_max = 0.05
