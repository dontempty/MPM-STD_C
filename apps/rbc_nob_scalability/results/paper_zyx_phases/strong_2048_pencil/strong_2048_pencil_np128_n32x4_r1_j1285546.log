# settings loaded from /scratch/t525a06/KDH/MPM-STD_C/apps/rbc_nob_scalability/decks_zyx_phases/strong_2048_pencil/strong_2048_pencil_np128.ini  (128 ranks, tdma=pascal)
[mesh]
nx = 2048
ny = 2048
nz = 2048

[domain]
lx = 24
ly = 24
lz = 4

[stretch]
uniform_z = false
gamma_z = 2.6

[process]
npx = 4
npy = 4
npz = 8

[physics]
rayleigh = 1000000
prandtl = 2547
delta_temperature = 40

[initial]
perturb = 0.05

[time]
max_step = 200
dt_max = 0.05
max_cfl = 0.3
viscous_coupling_number = 12

[output]
monitor_interval = 50

[timing]
warmup_steps = 50
solver_phases = true
