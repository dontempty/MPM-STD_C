[mesh]
nx = 2048
ny = 2048
nz = 2048

[domain]
lx = 24
ly = 24
lz = 4

[stretch]
uniform_z = false
gamma_z = 2.6

[process]
npx = 1
npy = 1
npz = 64

[physics]
rayleigh = 1000000
prandtl = 2547
delta_temperature = 40

[initial]
perturb = 0.05

[time]
max_step = 200
dt_max = 0.05
max_cfl = 0.3
viscous_coupling_number = 12

[output]
monitor_interval = 50

[timing]
warmup_steps = 50
solver_phases = true
