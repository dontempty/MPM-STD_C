[mesh]
nx = 512
ny = 1024
nz = 1024

[domain]
lx = 6
ly = 12
lz = 2

[stretch]
uniform_z = false
gamma_z = 2.6

[process]
npx = 1
npy = 2
npz = 2

[physics]
rayleigh = 1000000
prandtl = 2547
delta_temperature = 40

[initial]
perturb = 0.05

[time]
max_step = 200
dt_max = 0.05
