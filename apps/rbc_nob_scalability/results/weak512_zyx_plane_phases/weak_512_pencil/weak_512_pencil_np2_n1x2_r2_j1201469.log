[mesh]
nx = 512
ny = 512
nz = 1024

[domain]
lx = 6
ly = 6
lz = 2

[stretch]
uniform_z = false
gamma_z = 2.6

[process]
npx = 1
npy = 1
npz = 2

[physics]
rayleigh = 1000000
prandtl = 2547
delta_temperature = 40

[initial]
perturb = 0.05

[time]
max_step = 200
dt_max = 0.05
max_cfl = 0.3
viscous_coupling_number = 12

[output]
monitor_interval = 50

[timing]
warmup_steps = 50
solver_phases = true
