[mesh]
nx = 1024
ny = 1024
nz = 2048

[domain]
lx = 12
ly = 12
lz = 4

[stretch]
uniform_z = false
gamma_z = 2.6

[process]
npx = 2
npy = 2
npz = 4

[physics]
rayleigh = 1000000
prandtl = 2547
delta_temperature = 40

[initial]
perturb = 0.05

[time]
max_step = 200
dt_max = 0.05
