gamma_z = 2.6

[process]
npx = 1
npy = 1
npz = 8

[physics]
rayleigh = 1000000
prandtl = 2547
delta_temperature = 40

[initial]
perturb = 0.05

[time]
max_step = 200
dt_max = 0.05
