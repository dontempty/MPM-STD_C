+// 조각 수 p 선택 (nprocs == 1 순환 경로): 환경변수 PASCAL_TDMA_SEGMENTS = 0 자동 / 1 단일 스레드 커널 / 2·4·8·16 강제.
+// 자동 (2026-10-17 스윕 실측, docs/Scalability/momentum_scalability.md §7): 라인이 SM 당 ~640 개보다 적으면 지연 한계라
+// p = 16 이 가장 빠르고(H200 16k 라인: 2.76 → 0.77 ms, 65k: 4.01 → 2.93), 그보다 많으면 대역폭 한계라 단일 스레드
+// 커널(p = 1)이 가장 빠르다(H200 262k: 24.8 vs 25.8+, V100 65k: 15.3 vs 15.9). nrow 는 p 로 나뉘고 조각은 4행 이상.
+int choose_segments(const int nsys, const int nrow) {
+    static const int forced = [] {
+        const char* v = std::getenv("PASCAL_TDMA_SEGMENTS");
+        return v ? std::atoi(v) : 0;
+    }();
+    static const int sm_count = [] {
+        int dev = 0, n = 0;
+        cudaGetDevice(&dev);
+        cudaDeviceGetAttribute(&n, cudaDevAttrMultiProcessorCount, dev);
+        return n > 0 ? n : 80;
+    }();
+    constexpr int kLinesPerSmThreshold = 640;
+    int p = forced > 0 ? forced : (nsys < kLinesPerSmThreshold * sm_count ? 16 : 1);
+    while (p > 1 && (nrow % p != 0 || nrow / p < 4)) p /= 2;
+    return p;
+}
+
+void launch_tdma_cycl_segmented(double* a, double* b, double* c, double* d, const int nsys,
+                                const int nrow, const int p, cudaStream_t stream) {
+    const dim3 threads(kSegLines, p, 1);
+    const dim3 blocks(ceil_div(nsys, kSegLines), 1, 1);
+    const std::size_t shared_bytes = static_cast<std::size_t>(4) * 2 * p * kSegLines * sizeof(double);
+    tdma_cycl_segmented_kernel<<<blocks, threads, shared_bytes, stream>>>(a, b, c, d, nsys, nrow, p);
+    PASCAL_TDMA_CUDA_CHECK(cudaGetLastError());
+}
