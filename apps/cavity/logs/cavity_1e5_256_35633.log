  y: periodic
  z: wall  u-=dirichlet(0)  u+=dirichlet(0)  v-=dirichlet(0)  v+=dirichlet(0)  w-=dirichlet(0)  w+=dirichlet(0)  p-=neumann  p+=neumann  t-=neumann  t+=neumann
