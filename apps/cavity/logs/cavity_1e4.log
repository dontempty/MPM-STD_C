# settings loaded from input_cavity_1e4.ini  (1 ranks)
[mesh]
nx = 128
ny = 1
nz = 128

[domain]
lx = 1
ly = 0.0078125
lz = 1

[stretch]
uniform_z = true

[process]
npx = 1
npy = 1
npz = 1

[physics]
rayleigh = 10000
prandtl = 0.71
delta_temperature = 0
gravity_axis = 2

[initial]
perturb = 0
restart_from = ""
warmstart_from = ""

[boundary]
x = wall
y = periodic
z = wall
t_x_minus = 0.5
t_x_plus = -0.5
t_z_minus = adiabatic
t_z_plus = adiabatic

[time]
end_time = 120
dt_max = 0.01
max_cfl = 0.5
max_step = 0

[output]
stats_dir = "stats/1e4"
monitor_interval = 1000
stats_start_time = 0
stats_interval = 20
checkpoint_interval = 50000
checkpoint_dir = "checkpoints/1e4"
